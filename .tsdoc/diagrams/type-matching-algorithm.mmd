%% I/O Dependency Type Matching Algorithm
%% Shows how producer return types are matched with consumer parameter types

graph TB
    subgraph "Phase 1: Build Producer Map"
        AllSymbols[All Symbols<br/>1,438 total]
        AllSymbols --> FilterProducers{Filter functions<br/>and methods}

        FilterProducers -->|Yes| GetReturn[Extract return type]
        FilterProducers -->|No| SkipProd[Skip]

        GetReturn --> CheckPrim1{Is primitive?}
        CheckPrim1 -->|Yes - string, number, etc| SkipProd
        CheckPrim1 -->|No - User, Config, etc| AddToProd[Add to producer map]

        AddToProd --> ProducerMap["Map&lt;typeName, producers[]&gt;<br/><br/>Example:<br/>'User' → [{<br/>  symbolId: 'get-user',<br/>  symbolName: 'getUser',<br/>  returnType: 'User'<br/>}]"]
    end

    subgraph "Phase 2: Build Consumer Map"
        AllSymbols --> FilterConsumers{Filter functions<br/>and methods}

        FilterConsumers -->|Yes| GetParams[Extract parameter types]
        FilterConsumers -->|No| SkipCons[Skip]

        GetParams --> ParamLoop[For each parameter]
        ParamLoop --> CheckPrim2{Is primitive?}

        CheckPrim2 -->|Yes| SkipCons
        CheckPrim2 -->|No| AddToCons[Add to consumer map]

        AddToCons --> ConsumerMap["Map&lt;typeName, consumers[]&gt;<br/><br/>Example:<br/>'User' → [{<br/>  symbolId: 'update-user',<br/>  symbolName: 'updateUser',<br/>  paramType: 'User'<br/>}]"]
    end

    subgraph "Phase 3: Type Matching"
        ProducerMap --> IterateTypes[For each type name]
        ConsumerMap --> IterateTypes

        IterateTypes --> LookupProds[Get producers for type T]
        IterateTypes --> LookupCons[Get consumers for type T]

        LookupProds --> CheckMatch{Both exist?}
        LookupCons --> CheckMatch

        CheckMatch -->|No| NoMatch[No I/O dependency]
        CheckMatch -->|Yes| CartesianProd[Cartesian product<br/>producers × consumers]

        CartesianProd --> ProdLoop[For each producer P]
        ProdLoop --> ConsLoop[For each consumer C]

        ConsLoop --> CheckSelf{P == C?}
        CheckSelf -->|Yes - same symbol| SkipSelf[Skip self-reference]
        CheckSelf -->|No| CreateRel[Create I/O dependency]
    end

    subgraph "Phase 4: Relationship Creation"
        CreateRel --> CalcConf[Calculate confidence<br/>See confidence-scoring.mmd]

        CalcConf --> BuildRel["UnifiedRelationship {<br/>  id: 'io-dep-P-C',<br/>  type: 'io-dependency',<br/>  category: 'data-flow',<br/>  from: producerSymbol.id,<br/>  to: consumerSymbol.id,<br/>  direction: 'unidirectional',<br/>  strength: 'medium',<br/>  confidence: 0.6,<br/>  properties: {<br/>    dataType: 'User',<br/>    producerMethod: 'getUser',<br/>    consumerMethod: 'updateUser'<br/>  },<br/>  evidence: [...]<br/>}"]

        BuildRel --> AddToResults[Add to results array]
    end

    subgraph "Example Walkthrough"
        Ex[Example Type: 'User']

        Ex --> ExProd["Producers (2):<br/>1. getUser(): User<br/>2. fetchUser(): User"]
        Ex --> ExCons["Consumers (3):<br/>1. updateUser(user: User)<br/>2. deleteUser(user: User)<br/>3. notifyUser(user: User)"]

        ExProd --> ExMatch[Match]
        ExCons --> ExMatch

        ExMatch --> ExRels["Created Relationships (2×3 = 6):<br/>1. getUser → updateUser<br/>2. getUser → deleteUser<br/>3. getUser → notifyUser<br/>4. fetchUser → updateUser<br/>5. fetchUser → deleteUser<br/>6. fetchUser → notifyUser"]
    end

    subgraph "Primitive Filtering"
        Primitives["Filtered Types:<br/>string, number, boolean,<br/>void, any, unknown, never,<br/>null, undefined, object,<br/>Array, Promise"]

        PrimNote[Primitives too generic<br/>to be meaningful<br/>Would create massive noise]
    end

    subgraph "Results"
        AddToResults --> ResultsArray[I/O Dependencies Array<br/>7,446 relationships]

        ResultsArray --> Stats1[Average: ~5 deps per type]
        ResultsArray --> Stats2[~150 custom types tracked]
        ResultsArray --> Stats3[Most matched: Config, Symbol, User]

        Stats1 --> SaveDB[→ Database<br/>unified_relationships table]
        Stats2 --> SaveDB
        Stats3 --> SaveDB
    end

    subgraph "Pipeline Detection (Bonus)"
        ResultsArray --> BuildAdjList[Build I/O adjacency list]

        BuildAdjList --> FindChains[Find A→B→C chains]

        FindChains --> Pipeline["Pipeline Example:<br/>fetchUser() → transformUser() → saveUser()<br/><br/>Data flow:<br/>UserDTO → User → void"]

        Pipeline --> PipelineCount[25,809 pipelines detected<br/>length 3]
    end

    subgraph "Performance Optimization"
        Opt1[Use Map for O(1) lookups]
        Opt2[Filter primitives early]
        Opt3[Skip self-references]
        Opt4[Batch insert to DB]

        Opt1 --> PerfNote[Analysis completes<br/>in <200ms]
        Opt2 --> PerfNote
        Opt3 --> PerfNote
        Opt4 --> PerfNote
    end

    %% Styling
    style ProducerMap fill:#e1f5ff,stroke:#1864ab,stroke-width:2px
    style ConsumerMap fill:#ffe1e1,stroke:#c92a2a,stroke-width:2px
    style CheckMatch fill:#8b5cf6,stroke:#6d28d9,stroke-width:3px,color:#fff
    style BuildRel fill:#ffd93d,stroke:#fab005,stroke-width:2px
    style ResultsArray fill:#51cf66,stroke:#2f9e44,stroke-width:3px,color:#fff
    style Pipeline fill:#74c0fc,stroke:#339af0,stroke-width:2px
    style PrimNote fill:#fff4e1,stroke:#fab005,stroke-width:1px,stroke-dasharray: 5 5
    style PerfNote fill:#e7f5ff,stroke:#1864ab,stroke-width:1px,stroke-dasharray: 5 5

    %% Complexity annotations
    Complexity1[Time: O(n) - build maps]
    Complexity2[Space: O(n) - store maps]
    Complexity3[Matching: O(p×c) per type<br/>where p=producers, c=consumers]

    FilterProducers -.-> Complexity1
    FilterConsumers -.-> Complexity1
    ProducerMap -.-> Complexity2
    ConsumerMap -.-> Complexity2
    CartesianProd -.-> Complexity3

    style Complexity1 fill:#fff4e1,stroke:#fab005,stroke-width:1px,stroke-dasharray: 5 5
    style Complexity2 fill:#fff4e1,stroke:#fab005,stroke-width:1px,stroke-dasharray: 5 5
    style Complexity3 fill:#fff4e1,stroke:#fab005,stroke-width:1px,stroke-dasharray: 5 5
