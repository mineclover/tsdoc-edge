{
  "project": {
    "name": "tsdoc-edge-test",
    "version": "1.0.0",
    "rootDir": ".",
    "srcDirs": [
      "src"
    ]
  },
  "paths": {
    "commentsDir": ".tsdoc-comments",
    "databasePath": ".tsdoc/symbols.db",
    "jsonlDir": ".tsdoc/data",
    "outputDir": "output",
    "diagramsDir": ".tsdoc/diagrams"
  },
  "fold": {
    "enabled": true,
    "autoExport": false,
    "excludePatterns": []
  },
  "validation": {
    "strictMode": false,
    "minConnectivityScore": 70,
    "rules": {},
    "excludeDirs": [
      "examples",
      "architecture"
    ],
    "skipCodeImplDirs": [
      "concepts",
      "guides",
      "workflows",
      "relationships",
      "core",
      "core-components",
      "features",
      "code-generation",
      "parser",
      "primary-types",
      "types",
      "utilities"
    ]
  },
  "generator": {
    "template": "enhanced",
    "includePrivate": false,
    "includeInternal": false
  },
  "preCommit": {},
  "documentManagement": {
    "enabled": true,
    "managedDirs": [
      "managed"
    ],
    "excludeDirs": [
      "archive",
      "reference"
    ],
    "requireFrontmatter": false,
    "strictMode": false,
    "ignoreCodeBlocks": true
  }
}
