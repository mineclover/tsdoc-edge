```

## 2. Data Flow: 5 Information Streams

```mermaid
graph LR
    subgraph "Input"
        File[target file path]
    end

    subgraph "Stream 1: Symbols"
        S1[SELECT * FROM symbols<br/>WHERE file_path = ?]
        S2[Extract: id, name, type]
        S3[symbols: Symbol[]]
    end

    subgraph "Stream 2: Documents"
        D1[Read file content]
        D2[Regex: /@doc \[\[...\]\]/]
        D3[Search managed/ dirs]
        D4[relatedDocs: DocRef[]]
    end

    subgraph "Stream 3: Dependencies"
        E1[SELECT * FROM dependencies<br/>WHERE symbol_id IN ...]
        E2[Resolve target symbols]
        E3[Filter: exclude same file]
        E4[dependencies: Dep[]]
    end

    subgraph "Stream 4: Tests"
        T1[SELECT * FROM test_mappings<br/>WHERE symbol_id IN ...]
        T2[Group by test file path]
        T3[Detect type: unit/integration]
        T4[tests: Test[]]
    end

    subgraph "Stream 5: Usage"
        U1[SELECT * FROM dependencies<br/>WHERE target IN ...]
        U2[Resolve user symbols]
        U3[Filter: exclude same file]
        U4[usedBy: Usage[]]
    end

    subgraph "Output"
        Display[Display Context]
    end

    File --> S1 & D1
    S1 --> S2 --> S3
    D1 --> D2 --> D3 --> D4
    S3 --> E1
    E1 --> E2 --> E3 --> E4
    S3 --> T1
    T1 --> T2 --> T3 --> T4
    S3 --> U1
    U1 --> U2 --> U3 --> U4

    S3 & D4 & E4 & T4 & U4 --> Display

    classDef input fill:#e3f2fd,stroke:#0277bd
    classDef stream fill:#fff9c4,stroke:#f57f17
    classDef output fill:#c8e6c9,stroke:#2e7d32

    class File input
    class S1,S2,S3,D1,D2,D3,D4,E1,E2,E3,E4,T1,T2,T3,T4,U1,U2,U3,U4 stream
    class Display output
```

