{
  "name": "tsdoc-edge",
  "version": "0.13.0",
  "description": "Semantic convention governance and SSOT documentation connectivity for TypeScript",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist", "LICENSE", "README.md", "CHANGELOG.md"],
  "bin": {
    "tsdoc-edge": "./dist/cli.js",
    "tsdoc-edge-lsp": "./dist/lsp/server.js"
  },
  "scripts": {
    "lsp": "node dist/lsp/server.js",
    "clean": "node scripts/clean-dist.cjs",
    "build": "npm run clean && node scripts/run-ttsc.cjs -p tsconfig.ttsc.json && cp src/storage/schema.sql dist/storage/",
    "typecheck": "node scripts/run-ttsc.cjs -p tsconfig.ttsc.json --noEmit",
    "dev": "node scripts/run-ttsc.cjs -p tsconfig.ttsc.json --watch",
    "ttsc:version": "node scripts/run-ttsc.cjs --version",
    "test": "node scripts/run-test-lane.cjs",
    "test:typecheck": "node scripts/run-ttsc.cjs -p tsconfig.test.ttsc.json --noEmit",
    "test:compile": "node scripts/build-test-dist.cjs",
    "test:run": "node scripts/run-test-js.cjs",
    "test:ts7": "node scripts/run-test-lane.cjs",
    "test:watch": "node scripts/run-test-watch.cjs",
    "poc:convention": "npm run build && node scripts/prove-convention-poc.cjs",
    "poc:graph-lint": "npm run build && node scripts/prove-graph-lint-convention.cjs",
    "verify:package-tarball": "node scripts/verify-package-tarball.cjs",
    "verify:ttsc-provider-tarball": "node scripts/verify-ttsc-provider-tarball.cjs",
    "poc:ttsc-core": "npm run build && npm run verify:ttsc-external-pilot",
    "verify:ttsc-external-pilot": "node scripts/verify-ttsc-provider-tarball.cjs",
    "verify:ttsc-library-self": "node scripts/verify-ttsc-library-self.cjs",
    "verify:runtime-contract": "node scripts/verify-runtime-contract.cjs",
    "verify:platform-toolchain": "node scripts/ensure-platform-toolchain.cjs",
    "verify:document-validation": "node scripts/verify-document-validation.cjs",
    "verify:canonical-safety": "node scripts/verify-canonical-safety.cjs",
    "verify:release-preflight": "node scripts/verify-release-preflight.cjs",
    "verify:release-preflight-repeat": "node scripts/verify-release-preflight-repeat.cjs",
    "verify:external-release-matrix": "node scripts/verify-release-matrix.cjs",
    "verify:release-preflight-envelope": "node scripts/verify-release-preflight-envelope.cjs",
    "verify:release-qualification": "node scripts/verify-release-qualification.cjs",
    "verify:work-context-differential": "node scripts/verify-work-context-differential.cjs",
    "verify:work-context-differential:broader": "node scripts/verify-work-context-differential.cjs --fixture=scripts/fixtures/work-context-differential.v2.json",
    "verify:c2-capability-matrix": "node scripts/verify-capability-owner-matrix.cjs",
    "lint": "biome check . && npm run lint:budget && npm run lint:governance",
    "lint:budget": "node scripts/verify-lint-warning-budget.cjs",
    "lint:governance": "biome check src/convention src/semantic-graph src/spec-graph src/lsp src/indexer mcp-server/src src/storage/GraphRepository.ts src/storage/SpecGraphRepository.ts src/storage/AnalysisInputRevisionRepository.ts src/storage/ConventionCheckHistoryRepository.ts --error-on-warnings",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "prepublishOnly": "npm run build",
    "demo": "ts-node demo/poc-demo.ts",
    "rel:check": "node dist/cli.js relationship-check",
    "rel:impact": "node dist/cli.js relationship-impact",
    "rel:metrics": "node dist/cli.js relationship-metrics --top 20",
    "rel:validate": "node dist/cli.js relationship-validate",
    "rel:clusters": "node dist/cli.js relationship-clusters",
    "rel:help": "node dist/cli.js relationship-help",
    "safety:check": "./scripts/relationship/check-symbol-safety.sh",
    "report:weekly": "./scripts/relationship/weekly-report.sh .reports",
    "git:check-critical": "./scripts/relationship/find-critical-changes.sh"
  },
  "keywords": [
    "tsdoc",
    "documentation",
    "typescript",
    "api-documentation",
    "symbol-graph",
    "code-analysis",
    "dependency-analysis",
    "relationship-analysis",
    "convention-governance",
    "spec-conformance",
    "lsp"
  ],
  "author": "Junwoo Bang",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/junwoobang/tsdoc-edge.git"
  },
  "bugs": {
    "url": "https://github.com/junwoobang/tsdoc-edge/issues"
  },
  "homepage": "https://github.com/junwoobang/tsdoc-edge#readme",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "devDependencies": {
    "@babel/core": "7.28.5",
    "@biomejs/biome": "2.3.2",
    "@mermaid-js/mermaid-cli": "^11.12.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.24",
    "babel-jest": "29.7.0",
    "drizzle-kit": "^0.31.8",
    "jest": "^29.7.0",
    "ts-node": "^10.9.2",
    "ttsc": "0.18.4",
    "typescript-native": "npm:typescript@7.0.2"
  },
  "dependencies": {
    "@gephi/gephi-lite-sdk": "^1.0.0",
    "@microsoft/tsdoc": "^0.15.0",
    "better-sqlite3": "^12.4.1",
    "drizzle-orm": "^0.45.1",
    "typescript": "^5.3.3",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12"
  }
}
