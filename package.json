{
  "name": "tsdoc-edge",
  "version": "0.13.0",
  "description": "TSDoc-based specification documentation tool with type chain analysis and strict convention parsing",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "bin": {
    "tsdoc-edge": "./dist/cli.js",
    "tsdoc-edge-lsp": "./dist/lsp/server.js"
  },
  "scripts": {
    "lsp": "node dist/lsp/server.js",
    "build": "tsc && cp src/storage/schema.sql dist/storage/",
    "dev": "tsc --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "prepublishOnly": "npm run build",
    "demo": "ts-node demo/poc-demo.ts",
    "rel:check": "node dist/cli.js relationship-check",
    "rel:impact": "node dist/cli.js relationship-impact",
    "rel:metrics": "node dist/cli.js relationship-metrics --top 20",
    "rel:validate": "node dist/cli.js relationship-validate",
    "rel:clusters": "node dist/cli.js relationship-clusters",
    "rel:help": "node dist/cli.js relationship-help",
    "safety:check": "./scripts/relationship/check-symbol-safety.sh",
    "report:weekly": "./scripts/relationship/weekly-report.sh .reports",
    "git:check-critical": "./scripts/relationship/find-critical-changes.sh"
  },
  "keywords": [
    "tsdoc",
    "documentation",
    "typescript",
    "api-documentation",
    "symbol-graph",
    "code-analysis",
    "dependency-analysis",
    "relationship-analysis",
    "lsp"
  ],
  "author": "Junwoo Bang",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/junwoobang/tsdoc-edge.git"
  },
  "bugs": {
    "url": "https://github.com/junwoobang/tsdoc-edge/issues"
  },
  "homepage": "https://github.com/junwoobang/tsdoc-edge#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.2",
    "@mermaid-js/mermaid-cli": "^11.12.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.24",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@gephi/gephi-lite-sdk": "^1.0.0",
    "@microsoft/tsdoc": "^0.15.0",
    "better-sqlite3": "^12.4.1",
    "typescript": "^5.3.3",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12"
  }
}
