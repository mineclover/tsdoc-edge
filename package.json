{
  "name": "tsdoc-edge",
  "version": "0.1.0",
  "description": "TSDoc-based specification documentation tool with strict convention parsing",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "tsdoc-edge": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "prepublishOnly": "npm run build",
    "demo": "ts-node demo/poc-demo.ts"
  },
  "keywords": [
    "tsdoc",
    "documentation",
    "typescript",
    "spec",
    "api-documentation"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.19",
    "@typescript-eslint/eslint-plugin": "^7.0.1",
    "@typescript-eslint/parser": "^7.0.1",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "jest": "^29.7.0",
    "prettier": "^3.2.5",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@microsoft/tsdoc": "^0.15.0",
    "better-sqlite3": "^12.4.1",
    "typescript": "^5.3.3"
  }
}
