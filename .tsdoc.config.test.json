{
  "project": {
    "name": "tsdoc-edge-test",
    "version": "1.0.0",
    "rootDir": ".",
    "srcDirs": ["src"]
  },
  "paths": {
    "commentsDir": ".tsdoc-comments",
    "databasePath": ".tsdoc.db",
    "jsonlDir": "data",
    "outputDir": "output"
  },
  "fold": {
    "enabled": true,
    "autoExport": false,
    "excludePatterns": []
  },
  "validation": {
    "strictMode": false,
    "minConnectivityScore": 70,
    "rules": {}
  },
  "generator": {
    "template": "enhanced",
    "includePrivate": false,
    "includeInternal": false
  },
  "preCommit": {},
  "documentManagement": {
    "enabled": true,
    "managedDirs": ["managed-test"],
    "excludeDirs": ["examples", "archive"],
    "requireFrontmatter": false,
    "strictMode": false,
    "ignoreCodeBlocks": true
  }
}
