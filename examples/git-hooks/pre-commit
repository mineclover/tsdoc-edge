#!/bin/bash
#
# Git pre-commit hook for auto-updating document symbol index
#
# Installation:
#   cp examples/git-hooks/pre-commit .git/hooks/pre-commit
#   chmod +x .git/hooks/pre-commit
#

# Get staged markdown files in docs/
STAGED_MD_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep "^docs/.*\.md$")

if [ -n "$STAGED_MD_FILES" ]; then
  echo "🔍 Updating document symbol index..."

  for file in $STAGED_MD_FILES; do
    echo "  → $file"
    npx tsdoc-edge index-docs --file="$file"

    # Check if update succeeded
    if [ $? -ne 0 ]; then
      echo "❌ Failed to update index for $file"
      exit 1
    fi
  done

  # Stage the updated index file
  if [ -f ".tsdoc/doc-symbols.json" ]; then
    git add .tsdoc/doc-symbols.json
    echo "✅ Index updated and staged"
  fi
fi

exit 0
