{
  "name": "tsdoc-edge-mcp-server",
  "version": "1.0.0",
  "description": "MCP server for TSDoc Edge - provides LLM access to codebase knowledge graph",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "tsdoc-edge-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "node --test dist/**/*.test.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "tsdoc",
    "documentation",
    "knowledge-graph",
    "llm",
    "ai-tools"
  ],
  "author": "TSDoc Edge Team",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "zod": "^3.23.8",
    "better-sqlite3": "^11.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/better-sqlite3": "^7.6.12",
    "typescript": "^5.7.2",
    "tsx": "^4.19.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
